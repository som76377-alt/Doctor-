---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperTurnCanvas from "../components/PaperTurnCanvas";
---

<BaseLayout
  title="Your Clinic — Thoughtful, Personal Care"
  description="A calm, modern clinic website preview designed around clear information and patient-first care."
>
  <main class="page-shell">
      <div class="injection-stage" aria-hidden="true">
        <div class="paper-underpage"></div>
        <div class="paper-tear-shadow"></div>
        <PaperTurnCanvas client:only="react" />
        <svg class="injection-syringe" viewBox="0 0 80 240" role="presentation" focusable="false" aria-hidden="true">
          <g class="syringe-lines">
            <rect x="20" y="7" width="40" height="12" rx="4" />
            <path d="M40 19 V51" />
            <path d="M23 50 H57 M25 50 L28 58 M55 50 L52 58" />
            <path d="M28 58 H52 V166 Q52 171 48 174 L44 183 H36 L32 174 Q28 171 28 166 Z" />
            <path d="M31 64 H49" />
            <path d="M32 78 H44 M32 90 H39 M32 102 H44 M32 114 H39 M32 126 H44 M32 138 H39 M32 150 H44 M32 162 H39" />
            <path d="M34 183 L35 192 H45 L46 183" />
            <path d="M40 192 V238" />
          </g>
        </svg>
      </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-photo" aria-hidden="true"></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <header class="topbar">
        <a class="brand" href="#top" aria-label="Your Clinic home">
          <span class="brand-symbol" aria-hidden="true">
            <span></span><span></span>
          </span>
          <span class="brand-name">YOUR CLINIC</span>
        </a>
        <a class="top-link" href="/doctor">Meet the doctor <span aria-hidden="true">↗</span></a>
      </header>

      <div class="hero-content" id="top">
        <p class="kicker"><span class="kicker-line"></span> HEALTHCARE, WITH HEART</p>
        <h1 id="hero-title">A calmer way<br />to feel <em>better.</em></h1>
        <p class="hero-copy">
          Thoughtful care starts with listening. Find the support, clarity and
          confidence you need to take your next step.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="#contact">Explore care <span aria-hidden="true">↗</span></a>
          <a class="text-action" href="#approach">Our approach <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="hero-bottom">
        <div class="location-chip">
          <span class="location-dot" aria-hidden="true"></span>
          <span>YOUR CITY · CLINIC LOCATION</span>
        </div>
        <p class="hero-index"><span>01</span> / CARE THAT CENTRES YOU</p>
      </div>
      <div class="fabric" aria-hidden="true"><span></span><span></span><span></span></div>
    </section>

    <section class="approach" id="approach">
      <div class="approach-grid">
        <h2>Good care feels<br /><em>human.</em></h2>
        <div class="approach-copy">
          <p class="approach-lead">You deserve to feel heard, informed and cared for — not rushed through a checklist.</p>
          <p>Our approach begins with a conversation. We make space for your questions, explain your options in plain language, and help you understand what comes next.</p>
          <a class="underlined-link" href="#contact">A little more about us <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="values">
        <article class="value">
          <span class="value-number">01</span>
          <div><h3>Listen first</h3><p>Your concerns deserve time, attention and respect.</p></div>
          <span class="value-mark" aria-hidden="true">↗</span>
        </article>
        <article class="value">
          <span class="value-number">02</span>
          <div><h3>Clear answers</h3><p>Understand your care without the confusing jargon.</p></div>
          <span class="value-mark" aria-hidden="true">↗</span>
        </article>
        <article class="value">
          <span class="value-number">03</span>
          <div><h3>Care with you</h3><p>Decisions are conversations, made together.</p></div>
          <span class="value-mark" aria-hidden="true">↗</span>
        </article>
      </div>
    </section>


    <section class="doctor-feature" id="doctor" aria-labelledby="doctor-title">
      <div class="doctor-feature-inner">
        <p class="doctor-eyebrow"><span></span> MEET YOUR DOCTOR</p>
        <div class="doctor-feature-portrait">
          <img src="https://drupal-cdn-hfaeddcdbng5hfbg.a01.azurefd.net/sites/default/files/2026-03/dr-sanju-lall.jpg" alt="Dr. Sanju Lall, portrait from her public Apollo Hospitals profile" loading="lazy" />
        </div>
        <div class="doctor-feature-copy">
          <p class="doctor-overline">DENTISTRY · PUBLIC PROFILE DESIGN DEMO</p>
          <h2 id="doctor-title">Dr. Sanju Lall</h2>
          <p class="doctor-specialty">Prosthodontics · Implantology · Full-mouth rehabilitation</p>
          <p class="doctor-qualifications">BDS · MDS · FPFA (USA) · MFDI · MIDA</p>
          <p class="doctor-description">Apollo Hospitals lists Dr. Lall as a Professor and Senior Consultant with more than 30 years of experience. Her published profile also notes teaching experience and clinical work in India and Nepal.</p>
          <p class="doctor-demo-note">This is a design preview using public professional information. Dr. Lall is not represented as affiliated with “Your Clinic.” Verify permission before commercial use.</p>
          <a class="doctor-more" href="https://www.apollohospitals.com/doctors/dentist/delhi/dr-sanju-lall" target="_blank" rel="noreferrer">View official profile <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="contact-grain" aria-hidden="true"></div>
      <div class="contact-inner">
        <p class="kicker light-kicker"><span class="kicker-line"></span> YOUR NEXT STEP</p>
        <h2>Let’s start<br /><em>with a conversation.</em></h2>
        <p class="contact-copy">Clinic details and appointment booking will be connected once the clinic’s real information is provided.</p>
        <a class="contact-action" href="mailto:hello@example.com?subject=Clinic%20website%20enquiry">Email the clinic <span aria-hidden="true">↗</span></a>
        <p class="demo-note">DESIGN PREVIEW · CONTACT DETAILS ARE PLACEHOLDERS</p>
      </div>
      <footer class="footer">
        <a class="brand footer-brand" href="#top"><span class="brand-symbol" aria-hidden="true"><span></span><span></span></span><span class="brand-name">YOUR CLINIC</span></a>
        <span>CARE, WITH CLARITY.</span>
        <a href="#top" class="back-top">Back to top ↑</a>
      </footer>
    </section>
  </main>
</BaseLayout>

<script lang="ts">
  (() => {
    const setupInjection = () => {
      const stage = document.querySelector<HTMLElement>(".injection-stage");
      const sourcePage = document.querySelector<HTMLElement>(".page-shell");
      const underpage = stage?.querySelector<HTMLElement>(".paper-underpage");
      const doctor = sourcePage?.querySelector<HTMLElement>(".doctor-feature");
      const contact = sourcePage?.querySelector<HTMLElement>(".contact");
      if (!stage || !sourcePage || !underpage || !doctor || !contact || stage.dataset.ready === "true") return;

      const cloneSection = (section = document.createElement("div")) => {
        const clone = section.cloneNode(true);
        clone.removeAttribute("id");
        clone.setAttribute("aria-hidden", "true");
        clone.setAttribute("inert", "");
        clone.querySelectorAll<HTMLElement>("[id]").forEach(node => node.removeAttribute("id"));
        clone.querySelectorAll("script, iframe, video, audio, form").forEach(node => node.remove());
        clone.querySelectorAll<HTMLElement>("a, button, input, select, textarea, [tabindex]").forEach(node => {
          node.setAttribute("tabindex", "-1");
        });
        return clone;
      };

      // The back sheet uses the real next sections, with their original colors, images and typography.
      const backCopy = document.createElement("div");
      backCopy.className = "paper-underpage-copy";
      backCopy.setAttribute("aria-hidden", "true");
      backCopy.setAttribute("inert", "");
      Object.assign(backCopy.style, {
        position: "absolute",
        top: "0",
        left: "0",
        width: "100vw",
        margin: "0",
        pointerEvents: "none",
        background: "#efeee9"
      });
      const doctorCopy = cloneSection(doctor);
      const contactCopy = cloneSection(contact);
      Object.assign(doctorCopy.style, { width: "100%", maxWidth: "none" });
      Object.assign(contactCopy.style, { width: "100%", maxWidth: "none" });
      backCopy.append(doctorCopy, contactCopy);
      underpage.appendChild(backCopy);

      if (stage.parentElement !== document.body) document.body.appendChild(stage);
      stage.dataset.ready = "true";
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupInjection, { once: true });
    } else {
      setupInjection();
    }
  })();
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #efeee9; }
  :global(body) { margin: 0; min-width: 320px; color: #1e2c31; font-family: Inter, "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  .page-shell { overflow: hidden; background: #efeee9; }
  .hero { position: relative; isolation: isolate; display: flex; min-height: clamp(620px, 84svh, 820px); flex-direction: column; overflow: hidden; color: #f8f7f2; background: #efeee9; }
  .hero-photo { position: absolute; z-index: -3; inset: 0; background-image: url("https://images.pexels.com/photos/7108396/pexels-photo-7108396.jpeg?auto=compress&cs=tinysrgb&w=2400"); background-position: center 46%; background-size: cover; transform: scale(1.42); transform-origin: center center; will-change: transform; }
  .hero-shade { position: absolute; z-index: -2; inset: 0; background: linear-gradient(180deg, rgba(20,36,43,.16) 0%, rgba(20,36,43,.34) 45%, rgba(20,36,43,.56) 74%, rgba(20,36,43,.34) 100%); }
  .hero::after { content: ""; position: absolute; z-index: 0; right: 0; bottom: 0; left: 0; height: clamp(210px, 30vh, 300px); pointer-events: none; background: linear-gradient(180deg, rgba(239,238,233,0) 0%, rgba(239,238,233,.035) 14%, rgba(239,238,233,.12) 30%, rgba(239,238,233,.28) 48%, rgba(239,238,233,.54) 68%, rgba(239,238,233,.82) 86%, #efeee9 100%); }
  .grain, .contact-grain { position: absolute; z-index: -1; inset: 0; pointer-events: none; opacity: .11; mix-blend-mode: soft-light; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E"); }
  .topbar { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: 20px clamp(22px, 6.2vw, 94px); border-bottom: 1px solid rgba(255,255,255,.18); }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand-symbol { position: relative; display: inline-grid; width: 31px; height: 31px; place-items: center; border: 1px solid rgba(255,255,255,.74); border-radius: 50%; }
  .brand-symbol span { position: absolute; width: 13px; height: 1px; background: currentColor; }
  .brand-symbol span + span { transform: rotate(90deg); }
  .brand-name { font-size: 10px; font-weight: 700; letter-spacing: .2em; }
  .top-link { display: inline-flex; align-items: center; gap: 17px; font-size: 12px; text-decoration: none; }
  .top-link span { font-size: 17px; }
  .hero-content { position: relative; z-index: 1; width: min(760px, 100%); margin: auto 0; padding: 46px clamp(24px, 10.8vw, 164px) 52px; }
  .kicker { display: flex; align-items: center; gap: 11px; margin: 0 0 25px; color: #d9d4c5; font-size: 9px; font-weight: 700; letter-spacing: .2em; }
  .kicker-line { width: 28px; height: 1px; background: #c6bfae; }
  h1, h2 { margin: 0; font-weight: 400; letter-spacing: -.045em; text-wrap: balance; }
  h1 { font-size: clamp(58px, 8.6vw, 116px); line-height: .94; }
  h1 em, h2 em { color: #d3c9b5; font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  .hero-copy { max-width: 360px; margin: 21px 0 0; color: rgba(248,247,242,.88); font-size: 14px; line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 25px; }
  .primary-action { display: inline-flex; min-height: 50px; align-items: center; justify-content: space-between; gap: 34px; padding: 0 17px; color: #24383e; background: #e9e5db; font-size: 11px; font-weight: 650; text-decoration: none; transition: background .2s, transform .2s; }
  .primary-action:hover { transform: translateY(-2px); background: #fff; }
  .primary-action span { font-size: 17px; }
  .text-action { display: inline-flex; align-items: center; gap: 13px; color: #f8f7f2; font-size: 11px; text-decoration: none; }
  .text-action span { color: #d3c9b5; font-size: 16px; }
  .hero-bottom { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 clamp(22px, 6.2vw, 94px) 20px; color: #263a40; }
  .location-chip { display: flex; align-items: center; gap: 10px; font-size: 9px; letter-spacing: .13em; }
  .location-dot { width: 6px; height: 6px; border-radius: 50%; background: #9a8b70; box-shadow: 0 0 0 4px rgba(154,139,112,.15); }
  .hero-index { margin: 0; color: rgba(30,44,49,.68); font-size: 8px; letter-spacing: .14em; }
  .hero-index span { color: #1e2c31; }
  .injection-stage {
    position: fixed;
    z-index: 80;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    isolation: isolate;
    perspective: 1200px;
    perspective-origin: 50% 48%;
    transform-style: preserve-3d;
    transition: opacity .12s linear;
    --injection-y: 18px;
    --tear-bottom: calc(100dvh - 168px);
  }
  .injection-stage.is-active { opacity: 1; }
  .injection-stage[data-paper-error] { opacity: 0 !important; }

  /* Only the already-torn region is covered by the second page. */
  .paper-underpage {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    clip-path: inset(0 0 var(--tear-bottom) 0);
    background: #efeee9;
    contain: paint;
  }
  :global(.paper-underpage-copy) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    margin: 0;
    pointer-events: none;
    background: #efeee9;
  }
  :global(.paper-underpage-copy > .doctor-feature),
  :global(.paper-underpage-copy > .contact) {
    width: 100%;
    max-width: none;
  }
  :global(.paper-turn-window) {
    position: absolute;
    z-index: 3;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    clip-path: inset(0 0 var(--tear-bottom) 0);
    -webkit-clip-path: inset(0 0 var(--tear-bottom) 0);
    background: transparent;
  }
  :global(.paper-turn-window canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
  }
  .paper-tear-shadow {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50vw;
    width: 8px;
    height: 100vh;
    height: 100dvh;
    clip-path: inset(0 0 var(--tear-bottom) 0);
    transform: translateX(-50%);
    background: linear-gradient(90deg, rgba(28,23,17,.24), rgba(28,23,17,.06) 35%, transparent 50%, rgba(28,23,17,.06) 65%, rgba(28,23,17,.24));
  }
  .injection-syringe {
    position: absolute;
    z-index: 10;
    top: var(--injection-y);
    left: 50vw;
    display: block;
    width: 50px;
    height: 150px;
    overflow: visible;
    transform: translateX(-50%);
    color: #11110f;
  }
  .syringe-lines {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 650px) {
    .injection-syringe { width: 50px; height: 150px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .injection-stage { transition: none; }
  }

  .fabric { position: absolute; z-index: -1; right: -10%; bottom: -55px; left: -10%; height: 100px; opacity: .5; }
  .fabric span { position: absolute; left: -5%; width: 110%; height: 100px; border-top: 1px solid rgba(255,255,255,.48); border-radius: 50%; transform: rotate(-2deg); }
  .fabric span:nth-child(2) { top: 12px; opacity: .5; transform: rotate(2deg); }
  .fabric span:nth-child(3) { top: 25px; opacity: .3; transform: rotate(-4deg); }
  .approach { position: relative; z-index: 1; margin-top: 0; padding: 78px clamp(24px, 10.8vw, 164px) 108px; background: #efeee9; }
  .section-label { display: flex; gap: 18px; color: #687577; font-size: 9px; letter-spacing: .18em; }
  .section-label span:first-child { color: #a28e6b; }
  .approach-grid { display: grid; grid-template-columns: 1.05fr .8fr; gap: 8%; align-items: start; margin-top: 42px; }
  h2 { font-size: clamp(45px, 6.5vw, 78px); line-height: 1.02; }
  .approach h2 em { color: #9a8b70; }
  .approach-copy { max-width: 460px; padding-top: 7px; }
  .approach-copy p { color: #59686a; font-size: 14px; line-height: 1.8; }
  .approach-copy .approach-lead { margin-top: 0; color: #263a40; font-family: Georgia, "Times New Roman", serif; font-size: clamp(21px, 2vw, 25px); line-height: 1.42; letter-spacing: -.015em; }
  .underlined-link { display: inline-flex; gap: 18px; align-items: center; margin-top: 13px; padding-bottom: 9px; border-bottom: 1px solid #9e9a8e; font-size: 11px; text-decoration: none; }
  .values { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 72px; border-top: 1px solid #d4d2c9; }
  .value { display: flex; min-height: 160px; align-items: flex-start; gap: 15px; padding: 25px 18px 10px 0; border-bottom: 1px solid #d4d2c9; }
  .value + .value { padding-left: 24px; border-left: 1px solid #d4d2c9; }
  .value-number { color: #9a8b70; font-size: 9px; letter-spacing: .1em; }
  .value h3 { margin: 0 0 9px; color: #25393f; font-size: 15px; font-weight: 500; letter-spacing: -.02em; }
  .value p { max-width: 190px; margin: 0; color: #707a7a; font-size: 11px; line-height: 1.8; }
  .value-mark { margin-left: auto; color: #9a8b70; font-size: 15px; }
  .contact { position: relative; isolation: isolate; color: #f6f4ed; background: #203b43; }
  .contact-grain { z-index: -1; opacity: .09; }
  .contact-inner { padding: 100px clamp(24px, 10.8vw, 164px) 110px; }
  .light-kicker { color: #cfc4ad; }
  .contact h2 { max-width: 900px; font-size: clamp(44px, 7vw, 88px); }
  .contact h2 em { color: #d0c4ab; }
  .contact-copy { max-width: 420px; margin: 24px 0 0; color: rgba(246,244,237,.69); font-size: 12px; line-height: 1.8; }
  .contact-action { display: inline-flex; min-width: 190px; align-items: center; justify-content: space-between; margin-top: 28px; padding: 16px 17px; color: #263d43; background: #e8e3d8; font-size: 11px; text-decoration: none; }
  .contact-action span { font-size: 16px; }
  .demo-note { margin: 20px 0 0; color: rgba(246,244,237,.42); font-size: 8px; letter-spacing: .13em; }
  .footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 22px clamp(22px, 6.2vw, 94px); border-top: 1px solid rgba(255,255,255,.15); color: rgba(246,244,237,.6); font-size: 8px; letter-spacing: .14em; }
  .footer-brand { color: #f6f4ed; }
  .footer-brand .brand-symbol { width: 25px; height: 25px; }
  .footer-brand .brand-name { font-size: 9px; }
  .back-top { color: inherit; text-decoration: none; letter-spacing: .04em; }
  @media (min-width: 1200px) { .hero-content { padding-left: 13vw; } }
  @media (max-width: 650px) {
    .hero { min-height: clamp(580px, 82svh, 700px); }
    .topbar { padding-top: 16px; padding-bottom: 16px; }
    .hero-content { padding-top: 34px; padding-bottom: 38px; }
    .hero-copy { max-width: 300px; margin-top: 18px; font-size: 13px; line-height: 1.65; }
    .hero-bottom { align-items: flex-end; }
    .hero-index { max-width: 110px; text-align: right; line-height: 1.7; }
    .hero::after { height: clamp(190px, 30vh, 240px); background: linear-gradient(180deg, rgba(239,238,233,0) 0%, rgba(239,238,233,.04) 14%, rgba(239,238,233,.13) 31%, rgba(239,238,233,.31) 50%, rgba(239,238,233,.59) 70%, rgba(239,238,233,.84) 87%, #efeee9 100%); }
    .approach { margin-top: 0; padding-top: 62px; padding-bottom: 76px; background: #efeee9; }
    .approach-grid { grid-template-columns: 1fr; gap: 25px; margin-top: 30px; }
    .approach-copy .approach-lead { font-size: 21px; }
    .values { grid-template-columns: 1fr; margin-top: 55px; }
    .value { min-height: 115px; padding: 22px 0; }
    .value + .value { padding-left: 0; border-left: 0; }
    .value p { max-width: 250px; }
    .contact-inner { padding-top: 80px; padding-bottom: 82px; }
    .footer { flex-wrap: wrap; }
    .footer > span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .hero-photo { animation: none; } .primary-action { transition: none; } }

  .doctor-feature { padding: 88px clamp(24px, 9vw, 130px) 104px; background: #efeee9; color: #1e2c31; }
  .doctor-feature-inner { max-width: 1040px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .doctor-eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 28px; color:#6c7775; font-size:10px; font-weight:700; letter-spacing:.2em; }
  .doctor-eyebrow span { width:24px; height:1px; background:#82908b; }
  .doctor-feature-portrait { width:min(330px, 80vw); height:370px; display:flex; align-items:flex-end; justify-content:center; overflow:hidden; }
  .doctor-feature-portrait img { display:block; max-width:100%; max-height:100%; object-fit:contain; object-position:center bottom; mix-blend-mode:multiply; }
  .doctor-feature-copy { max-width:690px; margin-top:30px; }
  .doctor-overline { margin:0 0 16px; color:#77827e; font-size:9px; font-weight:700; letter-spacing:.18em; }
  .doctor-feature h2 { font-size:clamp(46px, 7vw, 78px); line-height:1; }
