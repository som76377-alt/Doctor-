---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Clinic — Homepage Preview"
  description="A minimal, mobile-first clinic homepage concept."
>
  <main class="cover">
    <!-- Future clinic-room photograph: set it as the cover background here. -->
    <div class="cover-image" aria-hidden="true"></div>
    <div class="light-wash" aria-hidden="true"></div>
    <div class="paper-grain" aria-hidden="true"></div>

    <header class="identity">
      <span class="mark" aria-hidden="true"><i></i><i></i></span>
      <span>CLINIC NAME</span>
    </header>

    <section class="intro">
      <p class="eyebrow">WELCOME</p>
      <h1>Care, with<br />clarity.</h1>
      <p class="description">A short introduction to the clinic will go here.</p>
    </section>

    <div class="fabric" aria-hidden="true">
      <span class="fold fold-a"></span>
      <span class="fold fold-b"></span>
      <span class="fold fold-c"></span>
      <span class="fold fold-d"></span>
      <span class="fabric-grain"></span>
    </div>

    <footer class="bottom">
      <div class="location"><span class="pin" aria-hidden="true"></span><span>CLINIC LOCATION</span></div>
      <a class="book" href="#book">Book an appointment <span aria-hidden="true">↗</span></a>
      <p class="note" id="book">Preview only · details and booking are not connected</p>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html), :global(body) {
    min-height: 100%;
    margin: 0;
    background: #22489e;
  }

  .cover {
    --blue: #22489e;
    --powder: #bdcdea;
    --stone: #d6cdc5;
    --paper: #efeef1;
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    overflow: hidden;
    color: var(--blue);
    background: linear-gradient(180deg, var(--paper) 0%, #e9eaf0 20%, var(--powder) 48%, #7791c7 73%, var(--blue) 100%);
  }

  /* Replace this background with the real clinic photo when it is ready. */
  .cover-image {
    position: absolute;
    z-index: -4;
    inset: 0;
    background: linear-gradient(180deg, rgba(239,238,241,.82) 0%, rgba(189,205,234,.48) 43%, rgba(34,72,158,.25) 68%, rgba(34,72,158,.88) 100%);
  }

  .light-wash {
    position: absolute;
    z-index: -3;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 18% 8%, rgba(255,255,255,.58), transparent 46%),
      linear-gradient(180deg, rgba(239,238,241,.45) 0%, rgba(214,205,197,.08) 28%, transparent 48%, rgba(34,72,158,.22) 100%);
  }

  .paper-grain, .fabric-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.08' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.24'/%3E%3C/svg%3E");
  }

  .paper-grain {
    z-index: -2;
    opacity: .13;
    mix-blend-mode: soft-light;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 27px 24px;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: .19em;
  }

  .mark {
    position: relative;
    display: grid;
    width: 29px;
    height: 29px;
    place-items: center;
    border: 1px solid rgba(34,72,158,.65);
    border-radius: 50%;
  }

  .mark i {
    position: absolute;
    width: 12px;
    height: 1.5px;
    background: var(--blue);
  }

  .mark i + i { transform: rotate(90deg); }

  .intro {
    padding: clamp(22px, 6vh, 56px) 24px 20px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .24em;
    opacity: .72;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 12vw, 64px);
    font-weight: 500;
    letter-spacing: -.07em;
    line-height: .96;
  }

  .description {
    max-width: 245px;
    margin: 15px 0 0;
    color: #344d80;
    font-size: 12px;
    line-height: 1.6;
  }

  .fabric {
    position: absolute;
    z-index: -1;
    right: -24%;
    bottom: 0;
    left: -24%;
    height: 43%;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(34,72,158,.16) 22%, rgba(34,72,158,.68) 63%, var(--blue) 100%);
  }

  .fold {
    position: absolute;
    left: -10%;
    width: 125%;
    height: 58%;
    border-radius: 50%;
    transform-origin: center;
  }

  .fold-a {
    top: -5%;
    transform: rotate(-8deg);
    background: linear-gradient(177deg, transparent 34%, rgba(255,255,255,.32) 42%, rgba(255,255,255,.07) 46%, rgba(9,29,78,.2) 53%, transparent 64%);
    filter: blur(1.2px);
  }

  .fold-b {
    top: 11%;
    transform: rotate(7deg) scaleX(1.08);
    background: linear-gradient(177deg, transparent 34%, rgba(8,28,78,.27) 43%, rgba(255,255,255,.25) 49%, rgba(189,205,234,.09) 53%, transparent 67%);
    filter: blur(2px);
  }

  .fold-c {
    top: 25%;
    transform: rotate(-5deg) scaleX(1.15);
    background: linear-gradient(177deg, transparent 34%, rgba(255,255,255,.15) 45%, rgba(5,22,68,.24) 51%, transparent 65%);
    filter: blur(2.5px);
  }

  .fold-d {
    top: 36%;
    transform: rotate(9deg) scaleX(1.1);
    background: linear-gradient(177deg, transparent 35%, rgba(255,255,255,.12) 45%, rgba(5,22,68,.18) 52%, transparent 67%);
    filter: blur(3px);
  }

  .fabric-grain {
    opacity: .19;
    mix-blend-mode: screen;
    mask-image: linear-gradient(180deg, transparent 0%, #000 30%);
  }

  .bottom {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 180px;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px 24px max(24px, env(safe-area-inset-bottom));
    color: #fff;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: .15em;
  }

  .pin {
    width: 7px;
    height: 7px;
    border: 1px solid rgba(255,255,255,.9);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255,255,255,.28);
  }

  .book {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    margin-top: 19px;
    padding: 0 16px;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 3px;
    color: var(--blue);
    background: var(--paper);
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
    transition: background .2s ease;
  }

  .book:hover { background: #fff; }
  .book span { font-size: 18px; font-weight: 400; }

  .note {
    margin: 11px 0 0;
    color: rgba(255,255,255,.52);
    font-size: 9px;
    text-align: center;
  }

  @media (min-width: 600px) {
    .identity { padding-left: 7vw; }
    .intro { padding-left: 7vw; }
    .bottom { padding-right: 7vw; padding-left: 7vw; }
    .book { max-width: 380px; }
    .fabric { height: 48%; }
  }

  @media (max-height: 700px) {
    .intro { padding-top: 14px; }
    h1 { font-size: clamp(38px, 10vw, 52px); }
    .description { margin-top: 9px; }
    .bottom { min-height: 145px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book { transition: none; }
  }
</style>
