---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Clinic Website"
  description="A clean foundation for a professional clinic website."
>
  <main class="min-h-screen bg-white text-neutral-800">
    <div class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-6 py-8 sm:px-10">
      <header class="border-b border-neutral-200 pb-5">
        <p class="text-sm font-medium tracking-wide text-neutral-500">CLINIC WEBSITE</p>
      </header>

      <section class="flex flex-1 flex-col justify-center py-20">
        <p class="mb-4 text-sm font-medium text-neutral-500">PROJECT FOUNDATION</p>
        <h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-neutral-900 sm:text-6xl">
          A clean start.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-neutral-600 sm:text-lg">
          The technical foundation is being prepared before clinic branding,
          content, appointments, and patient sign-in are added.
        </p>
      </section>

      <footer class="border-t border-neutral-200 pt-5 text-sm text-neutral-500">
        Built with accessibility, privacy, and reliability in mind.
      </footer>
    </div>
  </main>
</BaseLayout>
