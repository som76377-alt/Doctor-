---
import BaseLayout from "../layouts/BaseLayout.astro";
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Paper Reveal — Scroll Animation Prototype"
  description="An isolated prototype of a scroll-controlled split-paper reveal, with a deformable blue cover and a hidden page beneath."
>
  <main class="paper-demo">
    <a class="back-link" href={homeHref} aria-label="Back to clinic preview">
      <span aria-hidden="true">←</span> Clinic preview
    </a>

    <section class="reveal-track" data-reveal-track aria-label="Scroll to reveal the page beneath">
      <div class="reveal-stage" data-reveal-stage>
        <article class="under-page" data-under-page aria-labelledby="under-title" aria-hidden="true" inert>
          <div class="under-topline">
            <a class="under-brand" href={homeHref}>
              <span class="brand-mark" aria-hidden="true">+</span>
              <span>YOUR CLINIC</span>
            </a>
            <span class="under-label">A MORE HUMAN STANDARD</span>
          </div>

          <div class="under-content">
            <p class="under-kicker"><span></span> THE THINGS THAT MATTER</p>
            <h1 id="under-title">Good care<br />starts with <em>you.</em></h1>
            <p class="under-lead">
              Behind every appointment should be a person who listens, a plan you understand,
              and the confidence to ask one more question.
            </p>
            <div class="under-details">
              <div>
                <span class="detail-index">01</span>
                <h2>Time to listen</h2>
                <p>Your story comes before a checklist.</p>
              </div>
              <div>
                <span class="detail-index">02</span>
                <h2>Clarity, always</h2>
                <p>Know what happens next, and why.</p>
              </div>
              <div>
                <span class="detail-index">03</span>
                <h2>Care together</h2>
                <p>Decisions made with you, not for you.</p>
              </div>
            </div>
          </div>

          <div class="under-footer">
            <span>THOUGHTFUL BY DESIGN</span>
            <span>01 — 03</span>
          </div>
        </article>

        <article class="cover-artwork" data-cover-artwork aria-labelledby="cover-title">
          <div class="cover-orbit cover-orbit--one" aria-hidden="true"></div>
          <div class="cover-orbit cover-orbit--two" aria-hidden="true"></div>
          <div class="cover-shine" aria-hidden="true"></div>

          <header class="cover-masthead">
            <a class="cover-brand" href={homeHref} tabindex="-1">
              <span class="cover-mark" aria-hidden="true"><span></span><span></span></span>
              <span>YOUR CLINIC</span>
            </a>
            <span class="cover-edition">A NOTE ON CARE <span>·</span> VOL. 01</span>
          </header>

          <div class="cover-copy">
            <p class="cover-eyebrow"><span></span> HEALTHCARE, WITH HEART</p>
            <h2 id="cover-title">There is more<br />to care than<br /><em>meets the eye.</em></h2>
            <p class="cover-description">
              A good experience is built on small things that make a meaningful difference.
            </p>
          </div>

          <div class="cover-illustration" aria-hidden="true">
            <div class="illustration-ring illustration-ring--outer"></div>
            <div class="illustration-ring illustration-ring--inner"></div>
            <div class="illustration-core"></div>
            <span class="illustration-point illustration-point--a"></span>
            <span class="illustration-point illustration-point--b"></span>
          </div>

          <footer class="cover-footer">
            <div class="cover-index"><strong>01</strong><span> / A DIFFERENT PERSPECTIVE</span></div>
            <div class="scroll-cue">
              <span>SCROLL TO LOOK CLOSER</span>
              <span class="scroll-arrow" aria-hidden="true">↓</span>
            </div>
          </footer>
        </article>
        <div class="fallback-pieces" data-fallback-pieces aria-hidden="true"></div>
        <div class="reveal-seam" data-reveal-seam aria-hidden="true"></div>
        <div class="engine-note" data-engine-note aria-live="polite">Preparing paper surface</div>
      </div>
    </section>

    <section class="continuation" aria-labelledby="continuation-title">
      <div class="continuation-heading">
        <p class="under-kicker"><span></span> THE NEXT CHAPTER</p>
        <h2 id="continuation-title">What good care<br />should <em>feel like.</em></h2>
      </div>
      <div class="continuation-copy">
        <p>
          The reveal is the transition, not the destination. Once the paper clears the screen,
          the page underneath remains real HTML: responsive, selectable, accessible and ready
          to continue scrolling.
        </p>
        <a class="text-link" href={homeHref}>Return to the current clinic preview <span aria-hidden="true">↗</span></a>
      </div>
      <div class="continuation-rule"></div>
      <div class="continuation-meta">
        <span>SCROLL-DRIVEN PAPER STUDY</span>
        <span>THREE.JS + GSAP</span>
        <span>PROTOTYPE — NOT THE LIVE HOMEPAGE</span>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Native HTML/CSS paper curl. No canvas renderer or animation libraries.
  const track = document.querySelector("[data-reveal-track]");
  const stage = document.querySelector("[data-reveal-stage]");
  const cover = document.querySelector("[data-cover-artwork]");
  const underPage = document.querySelector("[data-under-page]");
  const fallbackLayer = document.querySelector("[data-fallback-pieces]");
  const seam = document.querySelector("[data-reveal-seam]");

  if (track && stage && cover && underPage && fallbackLayer && seam) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const strips = [];
    let viewportWidth = 1;
    let viewportHeight = 1;
    let frame = 0;
    let progress = 0;

    const mapCurl = (distance, halfWidth, amount) => {
      if (amount <= 0 || distance <= 0) return { x: distance, z: 0, angle: 0 };
      const segments = Math.max(16, Math.ceil((distance / halfWidth) * 84));
      const step = distance / segments;
      const rollRadius = Math.max(halfWidth * (0.11 + amount * 0.43), 1);
      const maxAngle = 0.08 + 3.35 * Math.pow(amount, 1.18);
      let x = 0;
      let z = 0;

      for (let index = 0; index < segments; index += 1) {
        const along = (index + 0.5) * step;
        const angle = maxAngle * Math.exp(-along / rollRadius);
        x += Math.cos(angle) * step;
        z += Math.sin(angle) * step;
      }

      return { x, z, angle: maxAngle * Math.exp(-distance / rollRadius) };
    };

    const buildPaper = () => {
      viewportWidth = Math.max(1, stage.clientWidth);
      viewportHeight = Math.max(1, stage.clientHeight);
      fallbackLayer.replaceChildren();
      strips.length = 0;

      const halfWidth = viewportWidth / 2;
      const stripCount = 96;
      const stripWidth = halfWidth / stripCount;

      for (const side of [-1, 1]) {
        const piece = document.createElement("div");
        piece.className = "fallback-piece " +
          (side < 0 ? "fallback-piece--left" : "fallback-piece--right");
        piece.style.width = halfWidth + "px";
        piece.style.height = viewportHeight + "px";
        piece.style.left = (side < 0 ? 0 : halfWidth) + "px";

        for (let index = 0; index < stripCount; index += 1) {
          const localLeft = index * stripWidth;
          const globalLeft = (side < 0 ? 0 : halfWidth) + localLeft;
          const baseCenterX = globalLeft + stripWidth / 2;
          const distance = side < 0
            ? halfWidth - baseCenterX
            : baseCenterX - halfWidth;

          const strip = document.createElement("div");
          strip.className = "fallback-strip";
          strip.style.left = localLeft + "px";
          strip.style.width = stripWidth + "px";
          strip.style.height = viewportHeight + "px";

          const front = cover.cloneNode(true);
          front.removeAttribute("data-cover-artwork");
          front.removeAttribute("aria-labelledby");
          front.setAttribute("aria-hidden", "true");
          front.querySelectorAll("[id]").forEach((element) => element.removeAttribute("id"));
          front.classList.add("cover-artwork--clone");
          front.style.position = "absolute";
          front.style.inset = "0 auto auto 0";
          front.style.left = -globalLeft + "px";
          front.style.width = viewportWidth + "px";
          front.style.height = viewportHeight + "px";
          front.style.opacity = "1";
          front.style.visibility = "visible";
          front.style.pointerEvents = "none";

          const back = document.createElement("div");
          back.className = "fallback-strip-back";
          back.setAttribute("aria-hidden", "true");

          strip.append(front, back);
          piece.append(strip);
          strips.push({ element: strip, side, distance, baseCenterX });
        }

        fallbackLayer.append(piece);
      }

      cover.style.opacity = "0";
      cover.style.pointerEvents = "none";
      fallbackLayer.style.opacity = "1";
      fallbackLayer.style.display = "block";
      render(progress);
    };

    const render = (rawProgress) => {
      progress = Math.max(0, Math.min(1, rawProgress));
      const complete = progress >= 0.985;

      underPage.inert = !complete;
      if (complete) {
        underPage.removeAttribute("aria-hidden");
        cover.setAttribute("aria-hidden", "true");
      } else {
        underPage.setAttribute("aria-hidden", "true");
        cover.removeAttribute("aria-hidden");
      }

      seam.style.opacity = String(
        Math.min(0.95, progress * 5.2) * Math.max(0, 1 - progress * 1.5)
      );
      seam.style.transform =
        "translateX(-50%) scaleX(" + Math.max(0.3, 1 - progress * 0.62) + ")";

      const halfWidth = viewportWidth / 2;
      const outwardDrift = viewportWidth * 0.55 * progress * progress;

      for (const strip of strips) {
        const mapped = mapCurl(strip.distance, halfWidth, progress);
        const desiredCenterX =
          viewportWidth / 2 + strip.side * (mapped.x + outwardDrift);
        const translateX = desiredCenterX - strip.baseCenterX;
        const translateZ = strip.side < 0 ? mapped.z : -mapped.z;
        const shade = Math.min(
          0.58,
          progress * 0.4 + Math.abs(Math.sin(mapped.angle)) * 0.25
        );
        const gloss =
          Math.max(0, Math.cos(Math.abs(mapped.angle) - 0.72)) *
          Math.pow(progress, 0.35);

        strip.element.style.setProperty("--curl-shade", String(shade));
        strip.element.style.setProperty("--curl-gloss", String(gloss));
        strip.element.style.transform =
          "translate3d(" + translateX + "px, 0, " + translateZ + "px) " +
          "rotateY(" + (-strip.side * mapped.angle) + "rad)";
        strip.element.style.opacity = progress >= 0.999 ? "0" : "1";
      }
    };

    const scrollProgress = () => {
      frame = 0;
      if (reduceMotion.matches) return;
      const travel = Math.max(1, track.offsetHeight - stage.clientHeight);
      const passed = Math.max(0, -track.getBoundingClientRect().top);
      render(passed / travel);
    };

    const scheduleRender = () => {
      if (!frame) frame = window.requestAnimationFrame(scrollProgress);
    };

    if (reduceMotion.matches) {
      cover.style.display = "none";
      fallbackLayer.style.display = "none";
      seam.style.display = "none";
      underPage.inert = false;
      underPage.removeAttribute("aria-hidden");
    } else {
      buildPaper();
      window.addEventListener("scroll", scheduleRender, { passive: true });
      window.addEventListener("resize", () => {
        buildPaper();
        scheduleRender();
      }, { passive: true });
      scheduleRender();
    }
  }
</script>

<style>
  :global(html) { scroll-behavior: auto; background: #f1efe9; }
  :global(body) { margin: 0; background: #f1efe9; color: #172735; }
  :global(a) { color: inherit; }
  .paper-demo { min-width: 320px; overflow: clip; background: #f1efe9; }
  .back-link { position:absolute; z-index:20; top:22px; left:clamp(20px,4vw,48px); display:inline-flex; align-items:center; gap:8px; color:rgba(255,255,255,.78); text-decoration:none; font-size:12px; letter-spacing:.03em; mix-blend-mode:difference; }
  .back-link span { font-size:18px; line-height:1; }
  .reveal-track { position:relative; height:260svh; background:#f1efe9; }
  .reveal-stage { position:sticky; top:0; width:100%; height:100svh; min-height:100svh; overflow:hidden; isolation:isolate; perspective:1600px; background:#f1efe9; transform-style:preserve-3d; }
  .under-page { position:absolute; z-index:1; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(24px,4.8vw,70px) clamp(24px,7.4vw,112px) clamp(20px,3vw,42px); overflow:hidden; background:radial-gradient(ellipse at 83% 20%,rgba(185,202,211,.23),transparent 36%),#f1efe9; color:#172735; }
  .under-topline, .under-footer { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .under-brand { display:inline-flex; align-items:center; gap:10px; text-decoration:none; font-size:10px; font-weight:750; letter-spacing:.18em; }
  .brand-mark { display:grid; place-items:center; width:24px; height:24px; border:1px solid #aeb8b6; border-radius:50%; color:#557e77; font-size:21px; font-weight:300; line-height:1; }
  .under-label, .under-footer { color:#68777c; font-size:9px; font-weight:650; letter-spacing:.16em; }
  .under-content { width:100%; max-width:1120px; margin:auto; padding:30px 0 38px; }
  .under-kicker { display:flex; align-items:center; gap:10px; margin:0 0 25px; color:#70807f; font-size:10px; font-weight:750; letter-spacing:.19em; }
  .under-kicker span { display:inline-block; width:27px; height:1px; background:#73928d; }
  .under-content h1, .continuation-heading h2 { max-width:1000px; margin:0; font-size:clamp(3.2rem,8.4vw,8.1rem); font-weight:490; line-height:.91; letter-spacing:-.073em; }
  .under-content h1 em, .continuation-heading h2 em { color:#6d938b; font-family:Georgia,"Times New Roman",serif; font-weight:400; }
  .under-lead { max-width:520px; margin:26px 0 0; color:#56656b; font-size:clamp(14px,1.45vw,18px); line-height:1.7; }
  .under-details { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,3.2vw,46px); margin-top:clamp(24px,4.4vh,48px); border-top:1px solid #d8d9d1; }
  .under-details > div { padding-top:14px; }
  .detail-index { color:#81958f; font-size:10px; letter-spacing:.15em; }
  .under-details h2 { margin:10px 0 7px; font-size:clamp(14px,1.45vw,18px); font-weight:650; letter-spacing:-.025em; }
  .under-details p { max-width:230px; margin:0; color:#6b7778; font-size:12px; line-height:1.55; }
  .cover-artwork { position:absolute; z-index:2; inset:0; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(24px,4.8vw,70px) clamp(24px,7.4vw,112px) clamp(22px,3.2vw,44px); overflow:hidden; color:#f4f7fb; background:radial-gradient(ellipse at 79% 48%,rgba(89,150,203,.36),transparent 34%),radial-gradient(ellipse at 15% 100%,rgba(7,24,48,.46),transparent 44%),linear-gradient(125deg,#183b63 0%,#205183 48%,#17395d 100%); transition:opacity .12s linear; backface-visibility:hidden; }
  .cover-orbit { position:absolute; z-index:0; border:1px solid rgba(200,229,249,.17); border-radius:50%; pointer-events:none; }
  .cover-orbit--one { width:min(86vw,1100px); aspect-ratio:1; right:-22%; top:-36%; transform:rotate(-22deg); }
  .cover-orbit--two { width:min(62vw,780px); aspect-ratio:1; right:-10%; top:-18%; border-color:rgba(200,229,249,.12); }
  .cover-shine { position:absolute; inset:0; pointer-events:none; opacity:.34; background:linear-gradient(112deg,transparent 28%,rgba(226,241,255,.055) 47%,transparent 62%); }
  .cover-masthead { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; gap:18px; }
  .cover-brand { display:inline-flex; align-items:center; gap:12px; color:#f3f7fa; text-decoration:none; font-size:10px; font-weight:760; letter-spacing:.19em; }
  .cover-mark { position:relative; display:inline-block; width:25px; height:25px; border:1px solid rgba(230,243,251,.8); border-radius:50%; }
  .cover-mark span:first-child { position:absolute; left:11px; top:4px; bottom:4px; width:1px; background:#e9f1f8; }
  .cover-mark span:last-child { position:absolute; top:11px; left:4px; right:4px; height:1px; background:#e9f1f8; }
  .cover-edition { color:rgba(232,243,250,.63); font-size:9px; font-weight:650; letter-spacing:.16em; }
  .cover-edition span { padding:0 5px; color:#bedbef; }
  .cover-copy { position:relative; z-index:1; width:min(74%,840px); margin:auto 0; padding:28px 0 48px; }
  .cover-eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 clamp(20px,3.2vh,35px); color:#c5deef; font-size:10px; font-weight:750; letter-spacing:.2em; }
  .cover-eyebrow span { width:27px; height:1px; background:#a9cee8; }
  .cover-copy h2 { margin:0; font-size:clamp(3.2rem,9.1vw,9rem); font-weight:480; line-height:.86; letter-spacing:-.078em; }
  .cover-copy h2 em { color:#b9d9f1; font-family:Georgia,"Times New Roman",serif; font-weight:400; }
  .cover-description { max-width:410px; margin:clamp(20px,3.4vh,36px) 0 0; color:rgba(235,244,251,.76); font-size:clamp(13px,1.4vw,17px); line-height:1.68; }
  .cover-illustration { position:absolute; z-index:0; width:min(31vw,410px); aspect-ratio:1; right:clamp(16px,8vw,120px); top:50%; transform:translateY(-49%); border-radius:50%; pointer-events:none; }
  .illustration-ring { position:absolute; inset:0; border:1px solid rgba(189,222,245,.33); border-radius:50%; }
  .illustration-ring--inner { inset:15%; border-color:rgba(189,222,245,.42); }
  .illustration-core { position:absolute; inset:34%; border-radius:50%; background:radial-gradient(circle at 35% 28%,rgba(235,246,255,.75),rgba(140,190,226,.22) 38%,rgba(16,48,81,.05) 71%); border:1px solid rgba(220,239,252,.62); box-shadow:0 0 60px rgba(143,197,237,.18),inset 0 0 25px rgba(218,238,252,.14); }
  .illustration-point { position:absolute; width:7px; height:7px; border-radius:50%; background:#cee6f7; box-shadow:0 0 17px rgba(208,235,252,.65); }
  .illustration-point--a { left:17%; top:25%; }
  .illustration-point--b { right:13%; bottom:26%; width:5px; height:5px; }
  .cover-footer { position:relative; z-index:1; display:flex; align-items:flex-end; justify-content:space-between; gap:20px; }
  .cover-index { display:flex; align-items:center; gap:8px; color:rgba(229,241,249,.56); font-size:9px; letter-spacing:.14em; }
  .cover-index strong { color:#f2f7fb; font-size:15px; font-weight:600; letter-spacing:-.02em; }
  .scroll-cue { display:flex; align-items:center; gap:12px; color:rgba(236,245,251,.8); font-size:9px; font-weight:700; letter-spacing:.16em; }
  .scroll-arrow { display:grid; place-items:center; width:32px; height:32px; border:1px solid rgba(234,244,251,.4); border-radius:50%; color:#f4f8fc; font-size:15px; }
  .curl-shadow { position:absolute; z-index:3; top:-8%; bottom:-8%; width:clamp(100px,18vw,270px); pointer-events:none; opacity:0; background:radial-gradient(ellipse at center,rgba(1,12,24,.56) 0%,rgba(3,17,32,.36) 24%,rgba(6,22,38,.15) 52%,transparent 80%); filter:blur(19px); mix-blend-mode:multiply; will-change:left,opacity,transform; }
  .curl-shadow--left { left:50%; }
  .curl-shadow--right { left:50%; }
  .paper-canvas { position:absolute; z-index:4; inset:0; display:block; width:100%; height:100%; opacity:0; pointer-events:none; filter:drop-shadow(0 12px 16px rgba(3,16,32,.42)) drop-shadow(0 2px 3px rgba(220,241,255,.32)); transition:opacity .12s linear; }
  .fallback-pieces { position:absolute; z-index:4; inset:0; opacity:0; pointer-events:none; perspective:1600px; }
  .curl-glint { position:absolute; z-index:5; top:-8%; bottom:-8%; width:clamp(130px,30vw,340px); pointer-events:none; opacity:0; background:linear-gradient(90deg,transparent 0%,rgba(188,222,246,.05) 7%,rgba(214,237,252,.12) 20%,rgba(226,244,255,.34) 36%,rgba(248,253,255,.68) 47%,rgba(255,255,255,.78) 53%,rgba(220,242,255,.44) 64%,rgba(161,210,244,.16) 80%,transparent 100%); filter:blur(7px); mix-blend-mode:screen; will-change:left,opacity,transform; }
  .curl-glint--left, .curl-glint--right { left:50%; }
  .fallback-piece { position:absolute; top:0; width:50%; height:100%; overflow:visible; transform-style:preserve-3d; }
  .fallback-piece--left { left:0; }
  .fallback-piece--right { left:50%; right:auto; }
  .fallback-piece::after { content:""; position:absolute; top:0; bottom:0; width:2px; z-index:80; pointer-events:none; background:linear-gradient(90deg,rgba(255,255,255,.38),rgba(2,20,39,.32)); opacity:var(--progress,0); }
  .fallback-piece--left::after { right:0; }
  .fallback-piece--right::after { left:0; }
  .fallback-strip { position:absolute; top:0; overflow:hidden; transform-origin:50% 50%; transform-style:preserve-3d; backface-visibility:visible; will-change:transform; }
  .fallback-strip > .cover-artwork--clone { backface-visibility:hidden; }
  .fallback-strip::before { content:""; position:absolute; inset:0; z-index:50; pointer-events:none; background:linear-gradient(105deg,rgba(255,255,255,.04) 0%,rgba(239,249,255,.28) 18%,rgba(255,255,255,.025) 34%,transparent 54%,rgba(2,13,27,.2) 100%),linear-gradient(90deg,rgba(3,17,32,.32),transparent 56%,rgba(223,241,255,.22)); opacity:var(--curl-shade,0); }
  .fallback-strip::after { content:""; position:absolute; inset:-1px; z-index:60; pointer-events:none; background:linear-gradient(90deg,transparent 2%,rgba(240,250,255,.9) 46%,rgba(255,255,255,.06) 58%,transparent 100%); opacity:var(--curl-gloss,0); mix-blend-mode:screen; }
  .fallback-strip-back { position:absolute; inset:0; z-index:40; pointer-events:none; background:linear-gradient(115deg,#e4e0d7 0%,#fbfaf6 22%,#f1efe9 42%,#fffefa 52%,#e8e4db 75%,#f7f4ed 100%); transform:rotateY(180deg) translateZ(.2px); backface-visibility:hidden; }
  .fallback-strip-back::after { content:""; position:absolute; inset:0; background:linear-gradient(112deg,transparent 22%,rgba(255,255,255,.16) 36%,rgba(255,255,255,.82) 46%,rgba(255,255,255,.14) 53%,transparent 68%); opacity:var(--curl-gloss,0); }
  .cover-artwork--clone { max-width:none !important; }
  .reveal-seam { position:absolute; z-index:6; top:0; bottom:0; left:50%; width:1px; pointer-events:none; opacity:0; background:linear-gradient(180deg,transparent 2%,rgba(235,246,255,.88) 18%,rgba(7,26,48,.55) 52%,rgba(235,246,255,.68) 82%,transparent 100%); box-shadow:0 0 11px rgba(2,13,28,.28); }
  .engine-note { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .continuation { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr); column-gap:clamp(30px,8vw,120px); align-items:end; padding:clamp(72px,11vw,156px) clamp(24px,10vw,150px) 44px; background:#f1efe9; color:#172735; }
