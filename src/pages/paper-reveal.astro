---
import BaseLayout from "../layouts/BaseLayout.astro";
const homeHref = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Paper Reveal — Scroll Animation Prototype"
  description="An isolated prototype of a scroll-controlled split-paper reveal, with a deformable blue cover and a hidden page beneath."
>
  <main class="paper-demo">
    <a class="back-link" href={homeHref} aria-label="Back to clinic preview">
      <span aria-hidden="true">←</span> Clinic preview
    </a>

    <section class="reveal-track" data-reveal-track aria-label="Scroll to reveal the page beneath">
      <div class="reveal-stage" data-reveal-stage>
        <article class="under-page" data-under-page aria-labelledby="under-title" aria-hidden="true" inert>
          <div class="under-topline">
            <a class="under-brand" href={homeHref}>
              <span class="brand-mark" aria-hidden="true">+</span>
              <span>YOUR CLINIC</span>
            </a>
            <span class="under-label">A MORE HUMAN STANDARD</span>
          </div>

          <div class="under-content">
            <p class="under-kicker"><span></span> THE THINGS THAT MATTER</p>
            <h1 id="under-title">Good care<br />starts with <em>you.</em></h1>
            <p class="under-lead">
              Behind every appointment should be a person who listens, a plan you understand,
              and the confidence to ask one more question.
            </p>
            <div class="under-details">
              <div>
                <span class="detail-index">01</span>
                <h2>Time to listen</h2>
                <p>Your story comes before a checklist.</p>
              </div>
              <div>
                <span class="detail-index">02</span>
                <h2>Clarity, always</h2>
                <p>Know what happens next, and why.</p>
              </div>
              <div>
                <span class="detail-index">03</span>
                <h2>Care together</h2>
                <p>Decisions made with you, not for you.</p>
              </div>
            </div>
          </div>

          <div class="under-footer">
            <span>THOUGHTFUL BY DESIGN</span>
            <span>01 — 03</span>
          </div>
        </article>

        <article class="cover-artwork" data-cover-artwork aria-labelledby="cover-title">
          <div class="cover-orbit cover-orbit--one" aria-hidden="true"></div>
          <div class="cover-orbit cover-orbit--two" aria-hidden="true"></div>
          <div class="cover-shine" aria-hidden="true"></div>

          <header class="cover-masthead">
            <a class="cover-brand" href={homeHref} tabindex="-1">
              <span class="cover-mark" aria-hidden="true"><span></span><span></span></span>
              <span>YOUR CLINIC</span>
            </a>
            <span class="cover-edition">A NOTE ON CARE <span>·</span> VOL. 01</span>
          </header>

          <div class="cover-copy">
            <p class="cover-eyebrow"><span></span> HEALTHCARE, WITH HEART</p>
            <h2 id="cover-title">There is more<br />to care than<br /><em>meets the eye.</em></h2>
            <p class="cover-description">
              A good experience is built on small things that make a meaningful difference.
            </p>
          </div>

          <div class="cover-illustration" aria-hidden="true">
            <div class="illustration-ring illustration-ring--outer"></div>
            <div class="illustration-ring illustration-ring--inner"></div>
            <div class="illustration-core"></div>
            <span class="illustration-point illustration-point--a"></span>
            <span class="illustration-point illustration-point--b"></span>
          </div>

          <footer class="cover-footer">
            <div class="cover-index"><strong>01</strong><span> / A DIFFERENT PERSPECTIVE</span></div>
            <div class="scroll-cue">
              <span>SCROLL TO LOOK CLOSER</span>
              <span class="scroll-arrow" aria-hidden="true">↓</span>
            </div>
          </footer>
        </article>

        <canvas class="paper-canvas" data-paper-canvas aria-hidden="true"></canvas>
        <div class="fallback-pieces" data-fallback-pieces aria-hidden="true"></div>
        <div class="reveal-seam" data-reveal-seam aria-hidden="true"></div>
        <div class="engine-note" data-engine-note aria-live="polite">Preparing paper surface</div>
      </div>
    </section>

    <section class="continuation" aria-labelledby="continuation-title">
      <div class="continuation-heading">
        <p class="under-kicker"><span></span> THE NEXT CHAPTER</p>
        <h2 id="continuation-title">What good care<br />should <em>feel like.</em></h2>
      </div>
      <div class="continuation-copy">
        <p>
          The reveal is the transition, not the destination. Once the paper clears the screen,
          the page underneath remains real HTML: responsive, selectable, accessible and ready
          to continue scrolling.
        </p>
        <a class="text-link" href={homeHref}>Return to the current clinic preview <span aria-hidden="true">↗</span></a>
      </div>
      <div class="continuation-rule"></div>
      <div class="continuation-meta">
        <span>SCROLL-DRIVEN PAPER STUDY</span>
        <span>THREE.JS + GSAP</span>
        <span>PROTOTYPE — NOT THE LIVE HOMEPAGE</span>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import * as THREE from "three";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import html2canvas from "html2canvas";

  gsap.registerPlugin(ScrollTrigger);

  type Side = -1 | 1;

  interface PaperHalf {
    side: Side;
    geometry: THREE.PlaneGeometry;
    basePositions: Float32Array;
    front: THREE.Mesh<THREE.PlaneGeometry, THREE.MeshPhysicalMaterial>;
    back: THREE.Mesh<THREE.PlaneGeometry, THREE.MeshPhysicalMaterial>;
    edge: THREE.Mesh<THREE.BufferGeometry, THREE.MeshStandardMaterial>;
    edgeGeometry: THREE.BufferGeometry;
    edgeRows: number;
    texture: THREE.CanvasTexture;
    width: number;
    height: number;
  }

  const track = document.querySelector<HTMLElement>("[data-reveal-track]");
  const stage = document.querySelector<HTMLElement>("[data-reveal-stage]");
  const cover = document.querySelector<HTMLElement>("[data-cover-artwork]");
  const underPage = document.querySelector<HTMLElement>("[data-under-page]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-paper-canvas]");
  const fallbackLayer = document.querySelector<HTMLElement>("[data-fallback-pieces]");
  const seam = document.querySelector<HTMLElement>("[data-reveal-seam]");
  const engineNote = document.querySelector<HTMLElement>("[data-engine-note]");

  if (track && stage && cover && underPage && canvas && fallbackLayer && seam && engineNote) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const state = { progress: 0 };
    const halves: PaperHalf[] = [];
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 3000);
    camera.position.set(0, 0, 1500);
    camera.lookAt(0, 0, 0);
    let renderer: THREE.WebGLRenderer | null = null;
    let activeMode: "pending" | "webgl" | "fallback" | "reduced" = "pending";
    let viewportWidth = 1;
    let viewportHeight = 1;
    let captureVersion = 0;
    let resizeCall: ReturnType<typeof gsap.delayedCall> | null = null;
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.4);
    keyLight.position.set(-420, 520, 680);
    scene.add(new THREE.AmbientLight(0xffffff, 1.15), keyLight);
    const fillLight = new THREE.DirectionalLight(0xc3ddf7, 0.52);
    fillLight.position.set(540, -160, 420);
    scene.add(fillLight);

    const setNote = (message: string) => { engineNote.textContent = message; };

    const clearHalfMeshes = () => {
      for (const half of halves) {
        scene.remove(half.front, half.back, half.edge);
        half.geometry.dispose();
        half.edgeGeometry.dispose();
        half.front.material.dispose();
        half.back.material.dispose();
        half.edge.material.dispose();
        half.texture.dispose();
      }
      halves.length = 0;
    };

    const makeHalfCanvas = (source: HTMLCanvasElement, side: Side): HTMLCanvasElement => {
      const split = Math.floor(source.width / 2);
      const result = document.createElement("canvas");
      result.width = side < 0 ? split : source.width - split;
      result.height = source.height;
      const context = result.getContext("2d");
      if (!context) throw new Error("Canvas 2D context is unavailable.");
      const sourceX = side < 0 ? 0 : split;
      context.drawImage(source, sourceX, 0, result.width, result.height, 0, 0, result.width, result.height);
      return result;
    };

    const makeHalf = (side: Side, textureCanvas: HTMLCanvasElement) => {
      const halfWidth = viewportWidth / 2;
      const geometry = new THREE.PlaneGeometry(halfWidth, viewportHeight, 42, 34);
      const positions = geometry.attributes.position;
      const basePositions = Float32Array.from(positions.array as ArrayLike<number>);
      const texture = new THREE.CanvasTexture(textureCanvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.anisotropy = Math.min(renderer?.capabilities.getMaxAnisotropy() ?? 1, 4);
      texture.minFilter = THREE.LinearMipmapLinearFilter;
      texture.magFilter = THREE.LinearFilter;
      texture.generateMipmaps = true;

      const frontMaterial = new THREE.MeshPhysicalMaterial({
        map: texture,
        roughness: 0.87,
        metalness: 0,
        clearcoat: 0.025,
        clearcoatRoughness: 0.9,
        side: THREE.FrontSide,
      });
      const backMaterial = new THREE.MeshPhysicalMaterial({
        color: 0xdce5ee,
        roughness: 0.96,
        metalness: 0,
        side: THREE.BackSide,
      });
      const front = new THREE.Mesh(geometry, frontMaterial);
      const back = new THREE.Mesh(geometry, backMaterial);
      front.frustumCulled = false;
      back.frustumCulled = false;
      front.renderOrder = 2;
      back.renderOrder = 1;

      // A narrow animated cut edge gives the split a visible paper thickness.
      const edgeRows = 34;
      const edgeGeometry = new THREE.BufferGeometry();
      const edgePositions = new Float32Array((edgeRows + 1) * 2 * 3);
      const edgeIndices: number[] = [];
      for (let row = 0; row <= edgeRows; row += 1) {
        const y = viewportHeight / 2 - (row / edgeRows) * viewportHeight;
        for (let bank = 0; bank < 2; bank += 1) {
          const offset = (row * 2 + bank) * 3;
          edgePositions[offset] = side < 0 ? halfWidth / 2 : -halfWidth / 2;
          edgePositions[offset + 1] = y;
          edgePositions[offset + 2] = bank === 0 ? -0.9 : 0.9;
        }
        if (row < edgeRows) {
          const a = row * 2;
          edgeIndices.push(a, a + 2, a + 1, a + 1, a + 2, a + 3);
        }
      }
      edgeGeometry.setAttribute("position", new THREE.BufferAttribute(edgePositions, 3));
      edgeGeometry.setIndex(edgeIndices);
      edgeGeometry.computeVertexNormals();
      const edgeMaterial = new THREE.MeshStandardMaterial({
        color: 0xd0dbe5,
        roughness: 0.92,
        metalness: 0,
        transparent: true,
        opacity: 0,
        depthWrite: false,
        side: THREE.DoubleSide,
      });
      const edge = new THREE.Mesh(edgeGeometry, edgeMaterial);
      edge.frustumCulled = false;
      edge.renderOrder = 3;
      scene.add(back, front, edge);

      const half: PaperHalf = {
        side, geometry, basePositions, front, back, edge, edgeGeometry, edgeRows, texture,
        width: halfWidth, height: viewportHeight,
      };
      halves.push(half);
      return half;
    };

    const mapCurl = (distance: number, halfWidth: number, progress: number) => {
      if (progress <= 0 || distance <= 0) return { x: distance, z: 0 };
      const segments = Math.max(5, Math.ceil((distance / halfWidth) * 22));
      const step = distance / segments;
      let mappedX = 0;
      let mappedZ = 0;
      for (let index = 0; index < segments; index += 1) {
        const q = (index + 0.5) * step;
        // Curvature is concentrated at the split edge and decays across the sheet.
        // A larger angular sweep creates an actual rolled cross-section rather than a shallow bow.
        const rollProfile = Math.exp(-q / Math.max(1, halfWidth * 0.48));
        const theta = 2.55 * progress * rollProfile;
        mappedX += Math.cos(theta) * step;
        mappedZ += Math.sin(theta) * step;
      }
      return { x: mappedX, z: mappedZ };
    };

    const updateHalf = (half: PaperHalf, progress: number) => {
      const position = half.geometry.attributes.position as THREE.BufferAttribute;
      const vertices = position.array as Float32Array;
      const segmentCount = half.geometry.parameters.widthSegments;
      const halfWidth = half.width;
      const height = half.height;
      const columnMap: Array<{ x: number; z: number }> = [];

      for (let column = 0; column <= segmentCount; column += 1) {
        columnMap[column] = mapCurl(column / segmentCount * halfWidth, halfWidth, progress);
      }

      for (let vertex = 0; vertex < position.count; vertex += 1) {
        const offset = vertex * 3;
        const baseX = half.basePositions[offset];
        const baseY = half.basePositions[offset + 1];
        const columnT = half.side < 0
          ? (halfWidth / 2 - baseX) / halfWidth
          : (baseX + halfWidth / 2) / halfWidth;
        const column = Math.max(0, Math.min(segmentCount, Math.round(columnT * segmentCount)));
        const mapped = columnMap[column];
        const localX = half.side < 0 ? halfWidth / 2 - mapped.x : -halfWidth / 2 + mapped.x;
        const vertical = Math.min(1, Math.max(0, (baseY + height / 2) / height));
        const edgeWeight = Math.sin(vertical * Math.PI);
        const smallRipple = Math.sin(vertical * Math.PI * 4 + columnT * 2.4) *
          progress * edgeWeight * 2.2;
        vertices[offset] = localX;
        vertices[offset + 1] = baseY + smallRipple;
        vertices[offset + 2] = mapped.z * 0.88;
      }

      position.needsUpdate = true;
      half.geometry.computeVertexNormals();
      half.geometry.computeBoundingSphere();

      const edgePosition = half.edgeGeometry.attributes.position as THREE.BufferAttribute;
      const edgeVertices = edgePosition.array as Float32Array;
      const tangentAngle = 2.55 * progress;
      const normalX = -half.side * Math.sin(tangentAngle);
      const normalZ = Math.cos(tangentAngle);
      const edgeX = half.side < 0 ? half.width / 2 : -half.width / 2;
      for (let row = 0; row <= half.edgeRows; row += 1) {
        const baseY = half.height / 2 - (row / half.edgeRows) * half.height;
        const vertical = Math.min(1, Math.max(0, (baseY + half.height / 2) / half.height));
        const ripple = Math.sin(vertical * Math.PI * 4) * progress * Math.sin(vertical * Math.PI) * 2.2;
        for (let bank = 0; bank < 2; bank += 1) {
          const offset = (row * 2 + bank) * 3;
          const thicknessOffset = bank === 0 ? -0.9 : 0.9;
          edgeVertices[offset] = edgeX + normalX * thicknessOffset;
          edgeVertices[offset + 1] = baseY + ripple;
          edgeVertices[offset + 2] = normalZ * thicknessOffset;
        }
      }
      edgePosition.needsUpdate = true;
      half.edgeGeometry.computeVertexNormals();
      half.edge.material.opacity = Math.min(0.9, progress * 3.2) * (1 - progress * 0.2);

      // Keep the inner edge anchored near the split and let the curl do the work.
      // Only a small outward drift remains; large panel-like translation was the main failure.
      const reveal = progress * progress;
      const outwardDrift = viewportWidth * 0.19 * reveal;
      const turnAngle = progress * 1.38;
      half.front.position.set(
        half.side * half.width / 2 + half.side * outwardDrift,
        0,
        progress * 12,
      );
      half.back.position.copy(half.front.position);
      half.edge.position.copy(half.front.position);
      half.front.rotation.set(0, -half.side * turnAngle, 0);
      half.back.rotation.copy(half.front.rotation);
      half.edge.rotation.copy(half.front.rotation);
    };

    const renderProgress = (rawProgress: number) => {
      state.progress = Math.max(0, Math.min(1, rawProgress));
      const progress = state.progress;
      const pageIsRevealed = progress >= 0.985 || activeMode === "reduced";
      underPage.inert = !pageIsRevealed;
      if (pageIsRevealed) {
        underPage.removeAttribute("aria-hidden");
        cover.setAttribute("aria-hidden", "true");
      } else {
        underPage.setAttribute("aria-hidden", "true");
        cover.removeAttribute("aria-hidden");
      }
      seam.style.opacity = String(Math.min(0.95, progress * 5.2) * Math.max(0, 1 - progress * 1.5));
      seam.style.transform = "translateX(-50%) scaleX(" + Math.max(0.3, 1 - progress * 0.62) + ")";
      engineNote.style.opacity = String(Math.max(0, 1 - progress * 2));
      if (activeMode === "webgl" && renderer) {
        for (const half of halves) updateHalf(half, progress);
        renderer.render(scene, camera);
      } else if (activeMode === "fallback") {
        const pieces = Array.from(fallbackLayer.querySelectorAll<HTMLElement>(".fallback-piece"));
        for (const piece of pieces) {
          const side: Side = piece.dataset.side === "left" ? -1 : 1;
          const travel = side * viewportWidth * 0.19 * progress * progress;
          piece.style.setProperty("--progress", String(progress));
          piece.style.transform = "translate3d(" + travel + "px, 0, 0) rotateY(" + (-side * progress * 1.38) + "rad)";
          piece.style.opacity = progress >= 0.999 ? "0" : "1";
          piece.style.filter = "drop-shadow(" + (side * -3) + "px 10px 12px rgba(3, 18, 37, " + (0.28 * (1 - progress * 0.35)) + "))";
        }
      }
    };

    const activateFallback = () => {
      activeMode = "fallback";
      clearHalfMeshes();
      if (renderer) {
        renderer.setClearColor(0x000000, 0);
        renderer.clear();
        canvas.style.opacity = "0";
      }
      fallbackLayer.replaceChildren();

      for (const side of [-1, 1] as Side[]) {
        const piece = document.createElement("div");
        piece.className = "fallback-piece " + (side < 0 ? "fallback-piece--left" : "fallback-piece--right");
        piece.dataset.side = side < 0 ? "left" : "right";
        const clone = cover.cloneNode(true) as HTMLElement;
        clone.removeAttribute("data-cover-artwork");
        clone.removeAttribute("aria-labelledby");
        clone.setAttribute("aria-hidden", "true");
        clone.classList.add("cover-artwork--clone");
        clone.style.position = "absolute";
        clone.style.inset = "0 auto auto 0";
        clone.style.width = viewportWidth + "px";
        clone.style.height = viewportHeight + "px";
        clone.style.opacity = "1";
        clone.style.visibility = "visible";
        if (side > 0) clone.style.left = (-viewportWidth / 2) + "px";
        piece.append(clone);
        fallbackLayer.append(piece);
      }
      cover.style.opacity = "0";
      cover.style.pointerEvents = "none";
      fallbackLayer.style.opacity = "1";
      setNote("CSS paper fallback");
      renderProgress(state.progress);
    };

    const resizeRenderer = () => {
      viewportWidth = Math.max(1, stage.clientWidth);
      viewportHeight = Math.max(1, stage.clientHeight);
      camera.left = -viewportWidth / 2;
      camera.right = viewportWidth / 2;
      camera.top = viewportHeight / 2;
      camera.bottom = -viewportHeight / 2;
      camera.updateProjectionMatrix();
      if (renderer) {
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setSize(viewportWidth, viewportHeight, false);
      }
      keyLight.position.set(-viewportWidth * 0.34, viewportHeight * 0.28, 680);
      fillLight.position.set(viewportWidth * 0.42, -viewportHeight * 0.22, 420);
      if (activeMode === "fallback") {
        for (const piece of Array.from(fallbackLayer.querySelectorAll<HTMLElement>(".fallback-piece"))) {
          piece.style.width = (viewportWidth / 2) + "px";
          piece.style.height = viewportHeight + "px";
          const clone = piece.firstElementChild as HTMLElement | null;
          if (clone) {
            clone.style.width = viewportWidth + "px";
            clone.style.height = viewportHeight + "px";
            clone.style.left = piece.dataset.side === "right" ? (-viewportWidth / 2) + "px" : "0";
          }
        }
        renderProgress(state.progress);
      }
    };

    const captureCover = async () => {
      const version = ++captureVersion;
      viewportWidth = Math.max(1, stage.clientWidth);
      viewportHeight = Math.max(1, stage.clientHeight);
      resizeRenderer();

      const ratio = Math.min(window.devicePixelRatio || 1, 1.6);
      const snapshot = await html2canvas(cover, {
        backgroundColor: null,
        scale: ratio,
        useCORS: false,
        allowTaint: false,
        logging: false,
        width: viewportWidth,
        height: viewportHeight,
        onclone: (clonedDocument) => {
          const clonedCover = clonedDocument.querySelector<HTMLElement>("[data-cover-artwork]");
          if (clonedCover) {
            clonedCover.style.opacity = "1";
            clonedCover.style.visibility = "visible";
            clonedCover.style.transform = "none";
          }
        },
      });

      if (version !== captureVersion) return;
      clearHalfMeshes();
      makeHalf(-1, makeHalfCanvas(snapshot, -1));
      makeHalf(1, makeHalfCanvas(snapshot, 1));
      activeMode = "webgl";
      fallbackLayer.style.opacity = "0";
      cover.style.opacity = "0";
      cover.style.pointerEvents = "none";
      canvas.style.opacity = "1";
      setNote("Three.js mesh · scroll-controlled");
      renderProgress(state.progress);
    };

    if (prefersReducedMotion.matches) {
      activeMode = "reduced";
      track.classList.add("reduced-motion-mode");
      cover.style.display = "none";
      cover.setAttribute("aria-hidden", "true");
      underPage.inert = false;
      underPage.removeAttribute("aria-hidden");
      canvas.style.display = "none";
      fallbackLayer.style.display = "none";
      seam.style.display = "none";
      engineNote.style.display = "none";
    } else {
      resizeRenderer();
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance",
          premultipliedAlpha: false,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
        renderer.setClearColor(0x000000, 0);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.NoToneMapping;
        renderer.setSize(stage.clientWidth, stage.clientHeight, false);
        canvas.addEventListener("webglcontextlost", (event) => {
          event.preventDefault();
          activateFallback();
        });
      } catch {
        activateFallback();
      }

      const progressTween = gsap.to(state, {
        progress: 1,
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: "top top",
          end: "bottom bottom",
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: (self) => renderProgress(self.progress),
          onRefresh: (self) => renderProgress(self.progress),
        },
        onUpdate: () => renderProgress(state.progress),
      });

      if (renderer) {
        captureCover().catch(() => activateFallback());
      }
      renderProgress(0);

      window.addEventListener("resize", () => {
        if (resizeCall) resizeCall.kill();
        resizeCall = gsap.delayedCall(0.2, () => {
          resizeRenderer();
          if (activeMode === "webgl") captureCover().catch(() => activateFallback());
          else ScrollTrigger.refresh();
        });
      }, { passive: true });

      prefersReducedMotion.addEventListener("change", (event) => {
        if (event.matches) {
          progressTween.scrollTrigger?.kill(true);
          progressTween.kill();
          captureVersion += 1;
          clearHalfMeshes();
          renderer?.clear();
          canvas.style.display = "none";
          fallbackLayer.style.display = "none";
          cover.style.display = "none";
          cover.setAttribute("aria-hidden", "true");
          underPage.inert = false;
          underPage.removeAttribute("aria-hidden");
          seam.style.display = "none";
          engineNote.style.display = "none";
          track.classList.add("reduced-motion-mode");
          activeMode = "reduced";
          ScrollTrigger.refresh();
        } else {
          window.location.reload();
        }
      });
    }
  }
</script>

<style>
  :global(html) { scroll-behavior: auto; background: #f1efe9; }
  :global(body) { margin: 0; background: #f1efe9; color: #172735; }
  :global(a) { color: inherit; }
  .paper-demo { min-width: 320px; overflow: clip; background: #f1efe9; }
  .back-link { position:absolute; z-index:20; top:22px; left:clamp(20px,4vw,48px); display:inline-flex; align-items:center; gap:8px; color:rgba(255,255,255,.78); text-decoration:none; font-size:12px; letter-spacing:.03em; mix-blend-mode:difference; }
